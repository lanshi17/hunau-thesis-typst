  author = {Xiao, Zhubing and Yang, Zhi and Wang, Lu and Nie, Huagui and Zhong, Mei'e and Lai, Qianqian and Xu, Xiangju and Zhang, Lijie and Huang, Shaoming},
  date = {2015-05-13},
  journaltitle = {Advanced Materials},
  shortjournal = {Adv. Mater.},
  volume = {27},
  number = {18},
  pages = {2891-+},
  publisher = {Wiley-V C H Verlag Gmbh},
  issn = {0935-9648, 1521-4095},
  doi = {10.1002/adma.201405637},
  abstract = {An integrated, selective interlayer structure is developed to further mitigate the diffusion of polysulfides, simply by coating the surface of a C-S cathode with a graphene/TiO2 film. It is found that the application of the graphene/TiO2 film as an interlayer enables the porous carbon nanotubes-S cathode to exhibit a high reversible specific capacity and extraordinarily excellent cycling stability.},
